#!/bin/bash
# ============================================================
# Production deployment script
# ------------------------------------------------------------
# 1. Checks if local code is behind origin/main
# 2. If yes, pulls updates, (re)installs deps only if requirements changed,
#    runs migrations, collects static files,
#    and restarts Django + Nginx
# 3. If no updates are needed, it exits gracefully.
# ------------------------------------------------------------
# NOTE:
#   - This script may only run in production (ENVIRONMENT=prod)
# ============================================================

set -euo pipefail

# Load environment variables from .env if present
if [ -f .env ]; then
  export $(grep -v '^#' .env | xargs)
fi

# Abort if ENVIRONMENT is not 'prod'
if [ "${ENVIRONMENT:-}" != "prod" ]; then
  echo "❌ This script can only be executed in the production environment."
  echo "Current environment: '${ENVIRONMENT:-}'"
  exit 1
fi

# ============================================================
# Deployment logic
# ============================================================

source ../bin/activate

if [ -n "$(git status --porcelain)" ]; then
  echo "❌ Production worktree has local changes. Aborting before deploy."
  git status --short
  exit 1
fi

echo "🔍 Checking for updates..."
git fetch origin

LOCAL_HASH=$(git rev-parse HEAD)
REMOTE_HASH=$(git rev-parse origin/main)

if [ "$LOCAL_HASH" = "$REMOTE_HASH" ]; then
  echo "✅ Already up to date. No deployment needed."
  exit 0
fi

echo "⬇️  Updates found — deploying latest version..."

echo "📋 Commits to deploy:"
git --no-pager log --oneline "$LOCAL_HASH..$REMOTE_HASH"

CHANGED_FILES=$(git diff --name-only "$LOCAL_HASH" "$REMOTE_HASH")

# Check if requirements.txt changed between local and origin/main
REQ_CHANGED=0
if echo "$CHANGED_FILES" | grep -qx "requirements.txt"; then
  REQ_CHANGED=1
fi

# Check if Django migration files changed between local and origin/main
MIGRATIONS_CHANGED=0
if echo "$CHANGED_FILES" | grep -Eq '(^|/)migrations/[0-9][^/]*\.py$'; then
  MIGRATIONS_CHANGED=1
fi

if [ "$MIGRATIONS_CHANGED" -eq 1 ]; then
  echo "🗄️  Migration changes detected — creating database dump before deploy..."
  ./dump_db
else
  echo "🗄️  No migration changes detected — skipping database dump."
fi

# Reset to the latest version from origin
git reset --hard origin/main

# Install updated dependencies only if requirements changed
if [ "$REQ_CHANGED" -eq 1 ]; then
  echo "📦 requirements.txt changed — installing dependencies..."
  pip install -r requirements.txt
else
  echo "📦 requirements.txt unchanged — skipping pip install."
fi

# Apply migrations and collect static files
python manage.py migrate
python manage.py collectstatic --noinput

# Restart services
sudo supervisorctl restart django
sudo systemctl restart nginx

echo "🚀 Deployment completed successfully."
